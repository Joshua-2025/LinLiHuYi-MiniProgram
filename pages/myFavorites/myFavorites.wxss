/* pages/myFavorites/myFavorites.wxss */
.favorites-container {
    background: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
  }
  
  /* 页面标题 */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 0 10rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  .product-count {
    font-size: 28rpx;
    color: #999;
  }
  
  /* 收藏列表 */
  .favorites-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  }
  
  .favorite-item {
    display: flex;
    padding: 30rpx;
    border-bottom: 1rpx solid #f8f8f8;
    position: relative;
  }
  
  .favorite-item:last-child {
    border-bottom: none;
  }
  
  .product-image {
    width: 160rpx;
    height: 160rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 24rpx;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .product-image image {
    width: 100%;
    height: 100%;
  }
  
  .no-image-text {
    font-size: 24rpx;
    color: #999;
  }
  
  .product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-right: 120rpx; /* 给取消收藏按钮留空间 */
  }
  
  .product-title {
    font-size: 30rpx;
    color: #333;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  
  .product-price {
    font-size: 32rpx;
    color: #ff6b35;
    font-weight: bold;
    margin: 10rpx 0;
  }
  
  .product-meta {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    color: #999;
  }
  
  /* 取消收藏按钮 */
  .unfavorite-btn {
    position: absolute;
    right: 30rpx;
    top: 50%;
    transform: translateY(-50%);
    background: #f8f8f8;
    color: #666;
    border: none;
    border-radius: 20rpx;
    font-size: 24rpx;
    padding: 12rpx 20rpx;
    margin: 0;
    white-space: nowrap;
  }
  
  .unfavorite-btn::after {
    border: none;
  }
  
  .unfavorite-btn:active {
    background: #f0f0f0;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120rpx 0;
    color: #999;
  }
  
  .empty-icon {
    font-size: 100rpx;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    font-size: 32rpx;
    margin-bottom: 20rpx;
  }
  
  .empty-tip {
    font-size: 28rpx;
  }