/* pages/myProducts/myProducts.wxss */
.my-products-container {
    background: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
  }
  
  /* 页面标题 */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 0 10rpx;
  }
  
  .page-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  .product-count {
    font-size: 28rpx;
    color: #999;
  }
  
  /* 商品列表 */
  .products-list {
    background: white;
    border-radius: 20rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  }
  
  .product-item {
    display: flex;
    padding: 30rpx;
    border-bottom: 1rpx solid #f8f8f8;
    position: relative;
    min-height: 160rpx; /* 确保最小高度 */
  }
  
  .product-item:last-child {
    border-bottom: none;
  }
  
  /* 商品图片样式 */
  .product-image {
    width: 160rpx;
    height: 160rpx;
    border-radius: 12rpx;
    overflow: hidden;
    margin-right: 24rpx;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0; /* 防止图片被压缩 */
  }
  
  .product-img {
    width: 100%;
    height: 100%;
  }
  
  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
    border-radius: 12rpx;
  }
  
  .no-image-text {
    font-size: 24rpx;
    color: #999;
  }
  
  /* 商品信息区域 */
  .product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 160rpx; /* 与图片高度一致 */
    padding-right: 220rpx; /* 给操作按钮留出足够空间 */
  }
  
  .product-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10rpx;
  }
  
  .product-title {
    font-size: 30rpx;
    color: #333;
    line-height: 1.4;
    flex: 1;
    margin-right: 20rpx;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: 84rpx; /* 确保标题区域有足够高度 */
  }
  
  .product-status {
    font-size: 24rpx;
    padding: 6rpx 12rpx;
    border-radius: 20rpx;
    white-space: nowrap;
    flex-shrink: 0; /* 防止状态标签被压缩 */
  }
  
  .status-online {
    background: #e8f5e8;
    color: #07c160;
  }
  
  .status-offline {
    background: #f8f8f8;
    color: #999;
  }
  
  .status-sold {
    background: #fff0e8;
    color: #ff6b35;
  }
  
  .product-price {
    font-size: 32rpx;
    color: #ff6b35;
    font-weight: bold;
    margin: 8rpx 0;
  }
  
  /* 商品元信息 - 浏览和时间 */
  .product-meta {
    display: flex;
    justify-content: space-between;
    font-size: 24rpx;
    color: #999;
    margin-top: auto; /* 推到信息区域底部 */
    padding-top: 10rpx;
  }
  
  .publish-time, .view-count {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 操作按钮 - 垂直排列在右侧 */
  .action-buttons {
    position: absolute;
    right: 30rpx;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    align-items: flex-end;
  }
  
  .action-btn {
    font-size: 24rpx;
    padding: 10rpx 20rpx;
    border-radius: 20rpx;
    border: none;
    margin: 0;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
    min-width: 80rpx;
  }
  
  .edit-btn {
    background: #f0f0f0;
    color: #666;
  }
  
  .online-btn {
    background: #07c160;
    color: white;
  }
  
  .offline-btn {
    background: #ff9500;
    color: white;
  }
  
  .delete-btn {
    background: #ff4757;
    color: white;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120rpx 0;
    color: #999;
  }
  
  .empty-icon {
    font-size: 100rpx;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    font-size: 32rpx;
    margin-bottom: 20rpx;
  }
  
  .empty-tip {
    font-size: 28rpx;
    margin-bottom: 40rpx;
  }
  
  .publish-btn {
    background: #07c160;
    color: white;
    border-radius: 50rpx;
    font-size: 32rpx;
    padding: 20rpx 60rpx;
    margin: 0;
  }
  
  .publish-btn::after {
    border: none;
  }