<!-- pages/category/category.wxml -->
<view class="category-container">
  
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <icon type="search" size="14"></icon>
      <input 
        class="search-input" 
        placeholder="搜索商品..." 
        value="{{searchValue}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
    </view>
    <button class="cancel-btn" bindtap="onCancelSearch" wx:if="{{isSearching}}">取消</button>
  </view>

  <!-- 分类标题 -->
  <view class="category-header" wx:if="{{!isSearching}}">
    <text class="category-title">{{currentCategory}}分类</text>
    <text class="product-count">共{{products.length}}件商品</text>
  </view>

  <!-- 搜索标题 -->
  <view class="category-header" wx:else>
    <text class="category-title">搜索结果</text>
    <text class="product-count">"{{searchValue}}" 相关商品</text>
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <block wx:for="{{products}}" wx:key="_id">
      <view class="product-item" bindtap="onProductTap" data-id="{{item._id}}">
        <!-- 修改图片显示部分 -->
        <view class="product-image">
          <image 
            wx:if="{{item.images && item.images.length > 0}}" 
            src="{{item.images[0]}}" 
            mode="aspectFill"
            class="product-img"
          ></image>
          <view wx:else class="no-image">
            <text class="no-image-text">暂无图片</text>
          </view>
        </view>
        <view class="product-info">
          <view class="product-title">{{item.title}}</view>
          <view class="product-price">¥{{item.price}}</view>
          <view class="product-meta">
            <text class="product-location">{{item.sellerInfo.community}}</text>
            <text class="product-time">{{formatTime(item.createTime)}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{products.length === 0}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text" wx:if="{{!isSearching}}">该分类暂无商品</text>
    <text class="empty-text" wx:else>暂无搜索结果</text>
    <text class="empty-tip">去发布一个商品吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && products.length > 0}}">
    <text>加载中...</text>
  </view>
  <view class="load-more" wx:if="{{!hasMore && products.length > 0}}">
    <text>没有更多了</text>
  </view>

</view>