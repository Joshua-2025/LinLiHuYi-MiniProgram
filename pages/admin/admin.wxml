<!-- pages/admin/admin.wxml -->
<view class="admin-container">
  
  <!-- 管理员菜单 -->
  <view class="admin-menu">
    <view class="menu-item {{currentTab === 'users' ? 'active' : ''}}" bindtap="switchTab" data-tab="users">
      <text class="menu-icon">👥</text>
      <text class="menu-text">用户管理</text>
    </view>
    <view class="menu-item {{currentTab === 'products' ? 'active' : ''}}" bindtap="switchTab" data-tab="products">
      <text class="menu-icon">📦</text>
      <text class="menu-text">商品管理</text>
    </view>
    <view class="menu-item {{currentTab === 'stats' ? 'active' : ''}}" bindtap="switchTab" data-tab="stats">
      <text class="menu-icon">📊</text>
      <text class="menu-text">数据统计</text>
    </view>
  </view>

  <!-- 用户管理 -->
  <view class="tab-content" wx:if="{{currentTab === 'users'}}">
    <view class="search-bar">
      <input class="search-input" placeholder="搜索用户昵称..." value="{{searchKeyword}}" bindinput="onSearchInput" />
      <button class="search-btn" bindtap="searchUsers">搜索</button>
    </view>

    <view class="user-list">
      <block wx:for="{{users}}" wx:key="_id">
        <view class="user-item">
          <view class="user-avatar-section">
            <image class="user-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="user-badge {{item.isAdmin ? 'admin-badge' : 'user-badge'}}">
              {{item.isAdmin ? '管' : '普'}}
            </view>
          </view>
          <view class="user-info">
            <view class="user-name-section">
              <text class="user-name">{{item.nickName || '未设置昵称'}}</text>
              <text class="user-id full-id">{{item._id}}</text>
            </view>
            <view class="user-contact-section">
              <view class="contact-item">
                <text class="contact-icon">📱</text>
                <text class="contact-text">{{item.phone || '未绑定手机'}}</text>
              </view>
              <view class="contact-item">
                <text class="contact-icon">🏠</text>
                <text class="contact-text">{{item.community || '未设置小区'}}</text>
              </view>
            </view>
            <view class="user-meta-section">
              <text class="meta-item">注册: {{formatTime(item.createTime)}}</text>
              <text class="meta-item">商品: {{item.productCount || 0}}个</text>
            </view>
          </view>
          <view class="user-actions">
            <button class="action-btn {{item.isAdmin ? 'remove-admin' : 'set-admin'}}" 
                    bindtap="{{item.isAdmin ? 'removeAdmin' : 'setAsAdmin'}}" 
                    data-user="{{item}}">
              {{item.isAdmin ? '取消管理' : '设为管理'}}
            </button>
          </view>
        </view>
      </block>
      
      <!-- 空状态 -->
      <view wx:if="{{users.length === 0}}" class="empty-state">
        <text class="empty-icon">👥</text>
        <text class="empty-text">暂无用户数据</text>
      </view>
    </view>
  </view>

  <!-- 商品管理 -->
  <view class="tab-content" wx:if="{{currentTab === 'products'}}">
    <view class="filter-bar">
      <picker range="{{statusOptions}}" value="{{statusFilter}}" bindchange="onStatusFilterChange">
        <view class="filter-item">
          <text class="filter-label">状态:</text>
          <text class="filter-value">{{statusOptions[statusFilter]}}</text>
        </view>
      </picker>
      <picker range="{{categoryOptions}}" value="{{categoryFilter}}" bindchange="onCategoryFilterChange">
        <view class="filter-item">
          <text class="filter-label">分类:</text>
          <text class="filter-value">{{categoryOptions[categoryFilter]}}</text>
        </view>
      </picker>
    </view>

    <view class="product-list">
      <block wx:for="{{products}}" wx:key="_id">
        <view class="product-item">
          <view class="product-image-section">
            <image class="product-image" src="{{item.images && item.images[0] ? item.images[0] : '/images/no-image.png'}}" mode="aspectFill"></image>
            <view class="product-status-badge {{getStatusClass(item.status)}}">
              {{getStatusText(item.status)}}
            </view>
          </view>
          <view class="product-info">
            <view class="product-title-section">
              <text class="product-title">{{item.title}}</text>
              <text class="product-price">¥{{item.price}}</text>
            </view>
            <view class="product-meta-section">
              <view class="meta-item">
                <text class="meta-icon">👤</text>
                <text class="meta-text">{{item.sellerInfo.nickName}}</text>
              </view>
              <view class="meta-item">
                <text class="meta-icon">📁</text>
                <text class="meta-text">{{item.category}}</text>
              </view>
            </view>
            <view class="product-time-section">
              <text class="time-text">发布时间: {{formatTime(item.createTime)}}</text>
            </view>
          </view>
          <view class="product-actions">
            <button class="action-btn edit" bindtap="editProduct" data-product="{{item}}">编辑</button>
            <button class="action-btn {{item.status === 1 ? 'offline' : 'online'}}" bindtap="toggleProductStatus" data-product="{{item}}">
              {{item.status === 1 ? '下架' : '上架'}}
            </button>
            <button class="action-btn delete" bindtap="deleteProduct" data-product="{{item}}">删除</button>
          </view>
        </view>
      </block>
      
      <!-- 空状态 -->
      <view wx:if="{{products.length === 0}}" class="empty-state">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无商品数据</text>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="tab-content" wx:if="{{currentTab === 'stats'}}">
    <view class="stats-cards">
      <view class="stat-card">
        <view class="stat-number">{{stats.totalUsers}}</view>
        <view class="stat-label">总用户数</view>
        <text class="stat-icon">👥</text>
      </view>
      <view class="stat-card">
        <view class="stat-number">{{stats.totalProducts}}</view>
        <view class="stat-label">总商品数</view>
        <text class="stat-icon">📦</text>
      </view>
      <view class="stat-card">
        <view class="stat-number">{{stats.activeProducts}}</view>
        <view class="stat-label">在售商品</view>
        <text class="stat-icon">🛒</text>
      </view>
      <view class="stat-card">
        <view class="stat-number">{{stats.todayPosts}}</view>
        <view class="stat-label">今日发布</view>
        <text class="stat-icon">📅</text>
      </view>
    </view>

    <view class="charts-section">
      <view class="section-header">
        <text class="section-title">商品分类分布</text>
        <text class="section-subtitle">各分类商品数量统计</text>
      </view>
      <canvas canvas-id="categoryChart" class="chart-canvas"></canvas>
    </view>
  </view>

</view>