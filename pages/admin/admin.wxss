/* pages/admin/admin.wxss */
.admin-container {
    background: #f5f5f5;
    min-height: 100vh;
    padding: 20rpx;
  }
  
  /* 管理员菜单 */
  .admin-menu {
    display: flex;
    background: white;
    border-radius: 16rpx;
    margin-bottom: 24rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  }
  
  .menu-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 28rpx 20rpx;
    border-right: 1rpx solid #f0f0f0;
    transition: all 0.3s ease;
  }
  
  .menu-item:last-child {
    border-right: none;
  }
  
  .menu-item.active {
    background: #07c160;
    color: white;
  }
  
  .menu-icon {
    font-size: 36rpx;
    margin-bottom: 8rpx;
  }
  
  .menu-text {
    font-size: 24rpx;
    font-weight: 500;
  }
  
  /* 搜索栏 */
  .search-bar {
    display: flex;
    gap: 16rpx;
    margin-bottom: 24rpx;
    align-items: center;
  }
  
  .search-input {
    flex: 1;
    background: white;
    border-radius: 16rpx;
    padding: 20rpx 24rpx;
    font-size: 28rpx;
    height: 80rpx;
    box-sizing: border-box;
    border: 1rpx solid #e8e8e8;
  }
  
  .search-btn {
    background: #07c160;
    color: white;
    border-radius: 16rpx;
    font-size: 28rpx;
    padding: 0 32rpx;
    height: 80rpx;
    line-height: 80rpx;
    margin: 0;
    flex-shrink: 0;
  }
  
  .search-btn::after {
    border: none;
  }
  
  /* 用户列表 */
  .user-list {
    background: white;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  }
  
  .user-item {
    display: flex;
    padding: 24rpx;
    border-bottom: 1rpx solid #f5f5f5;
    align-items: flex-start;
  }
  
  .user-item:last-child {
    border-bottom: none;
  }
  
  /* 用户头像区域 */
  .user-avatar-section {
    position: relative;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .user-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #f8f8f8;
    border: 2rpx solid #f0f0f0;
  }
  
  .user-badge {
    position: absolute;
    top: -4rpx;
    right: -4rpx;
    width: 32rpx;
    height: 32rpx;
    border-radius: 50%;
    font-size: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid white;
    font-weight: bold;
  }
  
  .user-badge.user-badge {
    background: #f0f0f0;
    color: #666;
  }
  
  .user-badge.admin-badge {
    background: #07c160;
    color: white;
  }
  
  /* 用户信息区域 */
  .user-info {
    flex: 1;
    min-width: 0;
  }
  
  .user-name-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
  }
  
  .user-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .user-id {
    font-size: 20rpx;
    color: #999;
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  .user-contact-section {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    margin-bottom: 12rpx;
  }
  
  .contact-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
  }
  
  .contact-icon {
    font-size: 22rpx;
    width: 28rpx;
    text-align: center;
    flex-shrink: 0;
  }
  
  .contact-text {
    font-size: 24rpx;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .user-meta-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .meta-item {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 用户操作按钮 */
  .user-actions {
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  .action-btn {
    font-size: 22rpx;
    padding: 12rpx 20rpx;
    border-radius: 12rpx;
    white-space: nowrap;
    min-width: 100rpx;
    margin: 0;
    line-height: 1.2;
  }
  
  .action-btn.set-admin {
    background: #07c160;
    color: white;
  }
  
  .action-btn.remove-admin {
    background: #ff9500;
    color: white;
  }
  
  .action-btn::after {
    border: none;
  }
  
  /* 商品管理 */
  .filter-bar {
    display: flex;
    gap: 16rpx;
    margin-bottom: 24rpx;
  }
  
  .filter-item {
    flex: 1;
    background: white;
    border-radius: 16rpx;
    padding: 20rpx 24rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
    border: 1rpx solid #e8e8e8;
  }
  
  .filter-label {
    font-size: 26rpx;
    color: #666;
    flex-shrink: 0;
  }
  
  .filter-value {
    font-size: 26rpx;
    color: #333;
    font-weight: 500;
    flex: 1;
    text-align: right;
  }
  
  .product-list {
    background: white;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  }
  
  .product-item {
    display: flex;
    padding: 24rpx;
    border-bottom: 1rpx solid #f5f5f5;
    align-items: flex-start;
  }
  
  .product-item:last-child {
    border-bottom: none;
  }
  
  /* 商品图片区域 */
  .product-image-section {
    position: relative;
    margin-right: 20rpx;
    flex-shrink: 0;
  }
  
  .product-image {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    background: #f8f8f8;
    border: 1rpx solid #f0f0f0;
  }
  
  .product-status-badge {
    position: absolute;
    top: -6rpx;
    right: -6rpx;
    padding: 4rpx 10rpx;
    border-radius: 10rpx;
    font-size: 18rpx;
    font-weight: 500;
    border: 2rpx solid white;
  }
  
  /* 商品信息区域 */
  .product-info {
    flex: 1;
    min-width: 0;
  }
  
  .product-title-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 12rpx;
  }
  
  .product-title {
    font-size: 28rpx;
    color: #333;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    flex: 1;
    margin-right: 16rpx;
  }
  
  .product-price {
    font-size: 30rpx;
    color: #ff6b35;
    font-weight: bold;
    flex-shrink: 0;
  }
  
  .product-meta-section {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
    margin-bottom: 12rpx;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
  }
  
  .meta-icon {
    font-size: 20rpx;
    width: 24rpx;
    text-align: center;
    flex-shrink: 0;
  }
  
  .meta-text {
    font-size: 24rpx;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .product-time-section {
    margin-top: 8rpx;
  }
  
  .time-text {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 商品操作按钮 */
  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
    margin-left: 16rpx;
    flex-shrink: 0;
  }
  
  .action-btn.edit {
    background: #007AFF;
    color: white;
  }
  
  .action-btn.online {
    background: #07c160;
    color: white;
  }
  
  .action-btn.offline {
    background: #ff9500;
    color: white;
  }
  
  .action-btn.delete {
    background: #ff3b30;
    color: white;
  }
  
  /* 状态样式 */
  .status-online {
    background: #e8f5e8;
    color: #07c160;
  }
  
  .status-offline {
    background: #f8f8f8;
    color: #999;
  }
  
  .status-pending {
    background: #fff3cd;
    color: #856404;
  }
  
  .status-sold {
    background: #d4edda;
    color: #155724;
  }
  
  /* 数据统计 */
  .stats-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16rpx;
    margin-bottom: 24rpx;
  }
  
  .stat-card {
    background: white;
    border-radius: 16rpx;
    padding: 28rpx 24rpx;
    text-align: center;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
    position: relative;
  }
  
  .stat-number {
    font-size: 42rpx;
    color: #07c160;
    font-weight: bold;
    margin-bottom: 8rpx;
  }
  
  .stat-label {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 8rpx;
  }
  
  .stat-icon {
    font-size: 32rpx;
    opacity: 0.7;
  }
  
  .charts-section {
    background: white;
    border-radius: 16rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 20rpx;
  }
  
  .section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    display: block;
    margin-bottom: 4rpx;
  }
  
  .section-subtitle {
    font-size: 22rpx;
    color: #999;
  }
  
  .chart-canvas {
    width: 100%;
    height: 360rpx;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 80rpx 0;
    background: white;
  }
  
  .empty-icon {
    font-size: 72rpx;
    margin-bottom: 16rpx;
    opacity: 0.5;
  }
  
  .empty-text {
    font-size: 26rpx;
    color: #999;
  }