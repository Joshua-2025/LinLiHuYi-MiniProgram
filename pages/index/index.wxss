/* pages/index/index.wxss */
.container {
    background: #f5f5f5;
    min-height: 100vh;
    padding-top: 40rpx;
    padding-bottom: 120rpx;
  }
  
  /* 搜索栏 */
  .search-section {
    background: white;
    padding: 20rpx 30rpx;
    margin: 0 30rpx 20rpx 30rpx;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .search-bar {
    display: flex;
    align-items: center;
    padding: 20rpx 30rpx;
    background: #f8f8f8;
    border-radius: 30rpx;
  }
  
  .search-icon {
    margin-right: 15rpx;
    color: #999;
  }
  
  .search-input {
    flex: 1;
    font-size: 28rpx;
    color: #333;
  }
  
  .search-btn {
    background: #07c160;
    color: white;
    border-radius: 20rpx;
    font-size: 24rpx;
    padding: 12rpx 24rpx;
    margin-left: 15rpx;
    line-height: 1;
  }
  
  /* 主筛选 */
  .filter-section {
    background: white;
    padding: 25rpx 0;
    margin: 0 30rpx 20rpx 30rpx;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .filter-scroll {
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    height: 80rpx;
  }
  
  .filter-content {
    display: inline-block;
    white-space: nowrap;
    padding: 0 30rpx;
  }
  
  .filter-item {
    display: inline-block;
    padding: 16rpx 32rpx;
    margin-right: 20rpx;
    border-radius: 30rpx;
    border: 1rpx solid #e0e0e0;
    font-size: 28rpx;
    color: #666;
    background: #f8f8f8;
  }
  
  .filter-item.active {
    background: #07c160;
    color: white;
    border-color: #07c160;
  }
  
  /* 分类筛选 */
  .category-filter-section {
    background: white;
    padding: 25rpx 0;
    margin: 0 30rpx 20rpx 30rpx;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .category-scroll {
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    height: 80rpx;
  }
  
  .category-content {
    display: inline-block;
    white-space: nowrap;
    padding: 0 30rpx;
  }
  
  .category-item {
    display: inline-block;
    padding: 16rpx 32rpx;
    margin-right: 20rpx;
    border-radius: 30rpx;
    border: 1rpx solid #e0e0e0;
    font-size: 28rpx;
    color: #666;
    background: #f8f8f8;
  }
  
  .category-item.active {
    background: #ff6b35;
    color: white;
    border-color: #ff6b35;
  }
  
  /* 小区选择 */
  .community-picker-section {
    background: white;
    padding: 25rpx 30rpx;
    margin: 0 30rpx 20rpx 30rpx;
    border-radius: 16rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .community-picker-section .form-item {
    padding: 0;
    border: none;
    margin-bottom: 20rpx;
  }
  
  .community-picker-section .form-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
    font-weight: 500;
  }
  
  .community-picker-section .picker {
    padding: 25rpx;
    border: 1rpx solid #e0e0e0;
    border-radius: 12rpx;
    background: #fafafa;
    font-size: 28rpx;
    color: #333;
  }
  
  .community-picker-section .picker.placeholder {
    color: #999;
  }
  
  .current-filter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20rpx 0 0 0;
    border-top: 1rpx solid #f0f0f0;
    margin-top: 20rpx;
  }
  
  .filter-text {
    font-size: 26rpx;
    color: #666;
  }
  
  .clear-filter {
    font-size: 24rpx;
    color: #007AFF;
    text-decoration: underline;
  }
  
  /* 商品列表 */
  .goods-list {
    padding: 0 30rpx;
  }
  
  .goods-item {
    display: flex;
    background: white;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  }
  
  .goods-image {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    margin-right: 24rpx;
    flex-shrink: 0;
  }
  
  .goods-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .goods-title {
    font-size: 30rpx;
    color: #333;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .goods-price {
    font-size: 36rpx;
    color: #ff4757;
    font-weight: bold;
    margin: 15rpx 0;
  }
  
  .goods-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .goods-category {
    font-size: 22rpx;
    color: #999;
    background: #f0f0f0;
    padding: 6rpx 16rpx;
    border-radius: 12rpx;
  }
  
  .goods-community {
    font-size: 22rpx;
    color: #007AFF;
    background: #e6f3ff;
    padding: 6rpx 16rpx;
    border-radius: 12rpx;
  }
  
  /* 空状态 */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 30rpx;
    text-align: center;
    margin-top: 40rpx;
  }
  
  .empty-text {
    font-size: 28rpx;
    color: #999;
    line-height: 1.5;
  }
  
  .loading-section {
    text-align: center;
    padding: 40rpx;
    margin-top: 20rpx;
  }
  
  .loading-text {
    font-size: 26rpx;
    color: #999;
  }
  
  .no-more {
    text-align: center;
    padding: 40rpx;
    margin-top: 20rpx;
  }
  
  .no-more-text {
    font-size: 26rpx;
    color: #999;
  }