/* pages/index/index.wxss */
.container {
    background-color: #f5f5f5;
    min-height: 100vh;
  }
  
  /* 搜索栏样式 */
  .search-bar {
    padding: 15px;
    background: white;
  }
  
  .search-box {
    display: flex;
    align-items: center;
    padding: 10px 15px;
    background: #f5f5f5;
    border-radius: 20px;
    color: #999;
  }
  
  .search-text {
    margin-left: 8px;
    font-size: 14px;
  }
  
  /* 分类导航 */
  .category-nav {
    background: white;
    margin: 10px 0;
    padding: 15px;
  }
  
  .category-title {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
  }
  
  .category-list {
    display: flex;
    flex-wrap: wrap;
  }
  
  .category-item {
    width: 25%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 15px;
  }
  
  .category-icon {
    font-size: 24px;
    margin-bottom: 5px;
  }
  
  .category-name {
    font-size: 12px;
    color: #666;
  }
  
  /* 商品列表 */
  .product-section {
    background: white;
    margin-top: 10px;
    padding: 15px;
  }
  
  .section-title {
    font-size: 16px;
    font-weight: bold;
    margin-bottom: 15px;
  }
  
  .product-list {
    display: flex;
    flex-direction: column;
  }
  
  .product-item {
    display: flex;
    padding: 12px 0;
    border-bottom: 1px solid #f0f0f0;
  }
  
  /* 商品图片样式 */
  .product-image {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    margin-right: 12px;
    overflow: hidden;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .product-img {
    width: 100%;
    height: 100%;
  }
  
  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
    border-radius: 8px;
  }
  
  .no-image-text {
    font-size: 12px;
    color: #999;
  }
  
  .product-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  
  .product-title {
    font-size: 15px;
    color: #333;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  
  .product-price {
    font-size: 18px;
    color: #ff6b35;
    font-weight: bold;
    margin: 5px 0;
  }
  
  .product-meta {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #999;
  }
  
  .load-more {
    text-align: center;
    padding: 20px;
    color: #999;
    font-size: 14px;
  }