<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box" bindtap="onSearchTap">
      <icon type="search" size="14" color="#999"></icon>
      <text class="search-text">搜索你想要的物品...</text>
    </view>
  </view>

  <!-- 小区选择器 -->
  <view class="community-filter">
    <view class="filter-title">所在小区</view>
    <picker 
      range="{{communityList}}" 
      value="{{selectedCommunityIndex}}" 
      bindchange="onCommunityChange"
      class="community-picker"
    >
      <view class="picker-display {{selectedCommunity ? '' : 'placeholder'}}">
        {{selectedCommunity ? selectedCommunity : '全部小区'}}
        <icon type="clear" size="12" wx:if="{{selectedCommunity}}" bindtap="clearCommunityFilter" class="clear-icon"></icon>
      </view>
    </picker>
  </view>

  <!-- 分类导航 - 优化布局 -->
  <view class="category-nav">
    <view class="section-header">
      <text class="section-title">分类浏览</text>
      <text class="section-subtitle">找到心仪好物</text>
    </view>
    <view class="category-list">
      <block wx:for="{{categories}}" wx:key="id">
        <view class="category-item" bindtap="onCategoryTap" data-id="{{item.id}}">
          <view class="category-icon-wrapper">
            <text class="category-icon">{{item.icon}}</text>
          </view>
          <text class="category-name">{{item.name}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 商品列表 - 优化布局 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">最新发布</text>
      <text class="filter-indicator" wx:if="{{selectedCommunity}}">· {{selectedCommunity}}</text>
    </view>
    <view class="product-list">
      <block wx:for="{{products}}" wx:key="_id">
        <view class="product-card" bindtap="onProductTap" data-id="{{item._id}}">
          <!-- 商品图片 -->
          <view class="product-image">
            <image 
              wx:if="{{item.images && item.images.length > 0}}" 
              src="{{item.images[0]}}" 
              mode="aspectFill"
              class="product-img"
            ></image>
            <view wx:else class="no-image">
              <text class="no-image-text">暂无图片</text>
            </view>
            <!-- 价格标签 -->
            <view class="price-tag">¥{{item.price}}</view>
          </view>
          
          <!-- 商品信息 -->
          <view class="product-info">
            <view class="product-title">{{item.title}}</view>
            <view class="product-meta">
              <view class="community-badge">
                <icon type="location" size="12" color="#999"></icon>
                <text class="community-name">{{item.sellerInfo.community}}</text>
              </view>
              <text class="product-time">{{formatTime(item.createTime)}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text class="loading-text">加载中...</text>
  </view>
  <view class="load-more" wx:else>
    <text class="no-more-text">— 没有更多了 —</text>
  </view>
</view>