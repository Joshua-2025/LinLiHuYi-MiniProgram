  /* 提示信息 */
  .sold-notice,
  .offline-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    padding: 20rpx;
    background: #f8f8f8;
    border-radius: 12rpx;
    margin-top: 20rpx;
    font-size: 26rpx;
    color: #666;
  }
  
  .notice-icon {
    font-size: 28rpx;
  }
  
  .notice-text {
    font-weight: 500;
  }
  
  /* 留言相关样式 */
  .message-section {
    background: white;
    margin: 20rpx 0;
    padding: 30rpx;
  }
  
  .message-list {
    margin-top: 20rpx;
  }
  
  .message-item {
    display: flex;
    margin-bottom: 30rpx;
  }
  
  .own-message {
    flex-direction: row-reverse;
  }
  
  .other-message {
    flex-direction: row;
  }
  
  .message-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin: 0 20rpx;
  }
  
  .message-content {
    flex: 1;
    background: #f8f8f8;
    border-radius: 20rpx;
    padding: 20rpx;
    position: relative;
  }
  
  .own-message .message-content {
    background: #e8f5e8;
  }
  
  .message-sender {
    font-size: 24rpx;
    color: #666;
    margin-bottom: 10rpx;
  }
  
  .message-text {
    font-size: 28rpx;
    color: #333;
    line-height: 1.4;
    margin-bottom: 10rpx;
  }
  
  .message-time {
    font-size: 22rpx;
    color: #999;
    text-align: right;
  }
  
  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    font-size: 32rpx;
    color: #999;
  }