/* pages/detail/detail.wxss */
.detail-container {
    background: #f5f5f5;
    min-height: 100vh;
    padding-bottom: 120rpx;
  }
  
  /* 图片轮播 */
  .image-swiper {
    height: 500rpx;
    background: white;
  }
  
  .product-image {
    width: 100%;
    height: 100%;
  }
  
  .no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 32rpx;
    background: #f0f0f0;
  }
  
  /* 商品信息 */
  .info-section {
    background: white;
    padding: 30rpx;
    margin: 20rpx 0;
  }
  
  .price-section {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .current-price {
    font-size: 48rpx;
    color: #ff6b35;
    font-weight: bold;
    margin-right: 20rpx;
  }
  
  .original-price {
    font-size: 28rpx;
    color: #999;
    text-decoration: line-through;
  }
  
  /* 商品状态显示 */
  .status-section {
    margin-bottom: 20rpx;
  }
  
  .product-status {
    display: inline-block;
    padding: 12rpx 24rpx;
    border-radius: 30rpx;
    font-size: 26rpx;
    font-weight: 600;
    border: 2rpx solid transparent;
  }
  
  .status-pending {
    background: #fff3cd;
    color: #856404;
    border-color: #ffeaa7;
  }
  
  .status-online {
    background: #e8f5e8;
    color: #07c160;
    border-color: #a3e4a3;
  }
  
  .status-offline {
    background: #f8f8f8;
    color: #666;
    border-color: #e0e0e0;
  }
  
  .status-sold {
    background: #d4edda;
    color: #155724;
    border-color: #c3e6cb;
  }
  
  .title {
    font-size: 36rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 20rpx;
    line-height: 1.4;
  }
  
  .description {
    font-size: 30rpx;
    color: #666;
    line-height: 1.6;
    margin-bottom: 20rpx;
  }
  
  .meta-info {
    display: flex;
    justify-content: space-between;
    font-size: 26rpx;
    color: #999;
    margin-bottom: 10rpx;
  }
  
  .publish-time {
    font-size: 26rpx;
    color: #999;
  }
  
  /* 卖家信息 */
  .seller-section {
    background: white;
    padding: 30rpx;
    margin-bottom: 20rpx;
  }
  
  .section-title {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 20rpx;
  }
  
  .seller-info {
    display: flex;
    align-items: center;
  }
  
  .seller-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    overflow: hidden;
    margin-right: 20rpx;
  }
  
  .seller-avatar image {
    width: 100%;
    height: 100%;
  }
  
  .seller-name {
    font-size: 32rpx;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .seller-location {
    font-size: 26rpx;
    color: #666;
  }
  
  /* 操作区域通用 */
  .seller-actions,
  .buyer-actions {
    background: white;
    padding: 30rpx;
    margin: 20rpx 0;
  }
  
  .action-title {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 20rpx;
    text-align: center;
  }
  
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .button-row {
    display: flex;
    gap: 20rpx;
  }
  
